<div class="container mt-4">

    <!-- DASHBOARD -->
    <div class="row mb-4">

        <div class="col-md-2">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Clientes</h6>
                    <h3 class="text-primary">
                        @ViewBag.TotalClientes
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Pets</h6>
                    <h3 class="text-primary">
                        @ViewBag.TotalPets
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Serviços</h6>
                    <h3 class="text-primary">
                        @ViewBag.TotalServicos
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Agendamentos</h6>
                    <h3 class="text-success">
                        @ViewBag.TotalAgendamentos
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Pendentes</h6>
                    <h3 class="text-warning">
                        @ViewBag.AgendamentosPendentes
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- BOAS VINDAS -->
    <div class="card shadow">
        <div class="card-body text-center">

            <h2 class="mb-3">
                <i class="bi bi-heart-pulse text-primary"></i>
                Bem-vindo ao PetCare
            </h2>

            <p class="text-muted">
                Sistema de gerenciamento para PetShop.
                Cadastre clientes, gerencie pets e organize atendimentos.
            </p>

        </div>
    </div>

    <!-- MÓDULOS -->
    <div class="row mt-4">

        <div class="col-md-3 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <i class="bi bi-people text-primary"
                       style="font-size:40px"></i>

                    <h5 class="mt-3">Clientes</h5>

                    <p class="text-muted">
                        Gerencie os clientes cadastrados no sistema.
                    </p>

                    <a asp-controller="Clientes"
                       asp-action="Index"
                       class="btn btn-primary">
                        Abrir
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <i class="bi bi-heart text-primary"
                       style="font-size:40px"></i>

                    <h5 class="mt-3">Pets</h5>

                    <p class="text-muted">
                        Gerencie os pets vinculados aos clientes.
                    </p>

                    <a asp-controller="Pet"
                       asp-action="Index"
                       class="btn btn-primary">
                        Abrir
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <i class="bi bi-person-gear text-primary"
                       style="font-size:40px"></i>

                    <h5 class="mt-3">Usuários</h5>

                    <p class="text-muted">
                        Gerencie os usuários com acesso ao sistema.
                    </p>

                    <a asp-controller="UsuariosSistema"
                       asp-action="Index"
                       class="btn btn-primary">
                        Abrir
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <i class="bi bi-scissors text-primary"
                       style="font-size:40px"></i>

                    <h5 class="mt-3">Serviços</h5>

                    <p class="text-muted">
                        Gerencie os serviços oferecidos pelo PetShop.
                    </p>

                    <a asp-controller="Servicos"
                       asp-action="Index"
                       class="btn btn-primary">
                        Abrir
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <i class="bi bi-calendar-check text-primary"
                       style="font-size:40px"></i>

                    <h5 class="mt-3">Agendamentos</h5>

                    <p class="text-muted">
                        Controle de atendimentos e agendamentos.
                    </p>

                    <a asp-controller="Agendamentos"
                       asp-action="Index"
                       class="btn btn-primary">
                        Abrir
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>