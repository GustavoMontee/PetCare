@model IEnumerable<PetCare.Models.RelatorioServicoViewModel>

@{
    ViewData["Title"] = "Serviços Mais Utilizados";
}

<h1>Serviços Mais Utilizados</h1>

<div class="mb-3">

    <button onclick="window.print();"
            class="btn btn-secondary">

        <i class="bi bi-printer"></i>
        Imprimir Relatório

    </button>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-striped table-hover">

            <thead>

                <tr>

                    <th>Serviço</th>

                    <th>
                        Quantidade de Agendamentos
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <i class="bi bi-scissors text-primary"></i>

                                @item.NomeServico

                            </td>

                            <td>

                                <span class="badge bg-primary">

                                    @item.Quantidade

                                </span>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="2"
                            class="text-center text-muted">

                            Nenhum serviço encontrado.

                        </td>

                    </tr>
                }

            </tbody>

            <tfoot>

                <tr class="table-light">

                    <th>

                        Total de Serviços Utilizados

                    </th>

                    <th>

                        @Model.Count()

                    </th>

                </tr>

            </tfoot>

        </table>

    </div>

</div>

<style>

@@media print {

    nav,
    footer,
    .btn,
    form,
    .navbar,
    .dropdown {
        display: none !important;
    }

    body {
        margin: 20px;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    table {
        width: 100%;
    }

    h1 {
        text-align: center;
        margin-bottom: 20px;
    }
}

</style>